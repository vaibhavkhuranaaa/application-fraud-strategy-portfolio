# Copy to terraform.tfvars and fill in before any plan. Never commit terraform.tfvars.
#
# This file contains no secret values and must not be given any. The database
# password and the linking HMAC key are generated by Terraform and stored in Key
# Vault; they are never supplied here.

project     = "fraudstrategy"
environment = "staging"
location    = "eastus2"

# Image must already be pushed to the registry created by a previous apply.
# First apply: leave empty and target only the registry, push, then set this.
container_image = "cr<project><environment>.azurecr.io/fraud-strategy:<git-sha>"

# Cost control. Apply fails without at least one alert recipient.
monthly_budget_usd  = 40
budget_alert_emails = ["you@example.com"]

# Optional: one address permitted to reach PostgreSQL directly, for migrations.
# allowed_client_ip = "203.0.113.10"

web_min_replicas    = 0
web_max_replicas    = 2
batch_schedule_cron = "0 3 * * *"
